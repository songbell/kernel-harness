# cm-kernel-harness deployment config -- copy to `.env` and edit. `.env` is gitignored;
# never commit it and never paste its contents into a chat.
#
# Precedence everywhere: a shell `export` overrides `.env`.
#
# Two lanes, and the choice is forced by physics: every ckh tool compiles and runs a CM
# kernel on a GPU, so the server must live on the box that HAS the GPU.
#
#   LOCAL  lane -- the GPU is in this machine. `bash deploy/deploy_ckh.sh --local`.
#                  VS Code talks to it over stdio; nothing listens on a socket.
#   REMOTE lane -- the GPU is in another box. Fill §2, run `bash deploy/deploy_ckh.sh`.
#                  That box serves MCP over HTTP and your VS Code points at the URL.

# --- 1. transport -------------------------------------------------------------------
# Bind address for the HTTP transport. Loopback by default ON PURPOSE: these tools execute
# kernel code, so exposing the port is a real decision, not a default. deploy_ckh.sh sets
# 0.0.0.0 for the remote lane and refuses to do so without a token unless you insist.
CKH_HTTP_HOST=127.0.0.1
CKH_HTTP_PORT=8791

# Bearer token required on POST /mcp. Empty = no auth (only acceptable on loopback).
MCP_AUTH_TOKEN=

# --- 2. remote lane -----------------------------------------------------------------
# The GPU box to deploy onto. Leave CKH_REMOTE_HOST empty to stay local-only.
CKH_REMOTE_HOST=
CKH_REMOTE_USER=
# Install dir on that box; relative paths are resolved against the remote $HOME.
CKH_REMOTE_DIR=cm-kernel-harness
# SSH password. Keep it ONLY here (gitignored) or in ./.ckh_deploy.pass, or export SSHPASS.
# It is streamed to sshpass and never appears in a command line, process list, or log.
CKH_SSH_PASSWORD=
# Behind a corporate proxy the remote venv cannot reach PyPI; set it and pip is told.
CKH_PIP_PROXY=

# --- 3. client ----------------------------------------------------------------------
# Full MCP URL, if it is not simply http://$CKH_REMOTE_HOST:$CKH_HTTP_PORT/mcp.
CKH_MCP_URL=
CKH_HTTP_SCHEME=http

# VS Code reads .vscode/mcp.json only from a WORKSPACE FOLDER root. If you open this repo
# as a SUB-FOLDER of a bigger workspace, point this at that workspace root so the config
# lands where VS Code will actually look. Empty = write it into this repo.
CKH_MCP_CONFIG_DIR=
